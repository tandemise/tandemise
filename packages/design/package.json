{
  "name": "@tandemise/design",
  "version": "0.11.0",
  "description": "The Tandemise design system: brand palette, light/dark semantic roles, type, spacing, radius, motion, focus, stacking and density tokens as CSS, TypeScript and a Tailwind theme; the logo and icon set; and accessible React components over a component stylesheet.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tandemise/tandemise.git",
    "directory": "packages/design"
  },
  "homepage": "https://github.com/tandemise/tandemise/tree/main/packages/design#readme",
  "keywords": [
    "tandemise",
    "design-system",
    "design-tokens",
    "css-variables",
    "tailwindcss",
    "light-dark",
    "react",
    "components",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "css",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "default": "./dist/logo.js"
    },
    "./resolve": {
      "types": "./dist/resolve.d.ts",
      "default": "./dist/resolve.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "default": "./dist/tailwind.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./base.css": "./css/base.css",
    "./components.css": "./css/components.css",
    "./tailwind.css": "./css/tailwind.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "10.6.2",
    "vite": "^5.4.21"
  },
  "scripts": {
    "build": "tsc -b",
    "emit": "node scripts/emit.mjs",
    "emit:check": "node scripts/emit.mjs --check",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "storybook:typecheck": "tsc -p tsconfig.storybook.json",
    "storybook:a11y": "node scripts/storybook-a11y.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
