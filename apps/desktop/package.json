{
  "name": "@tandemise/desktop",
  "productName": "Tandemise",
  "description": "A local-first desktop OS for running a software company with interchangeable AI workers.",
  "version": "0.12.3",
  "license": "Apache-2.0",
  "private": true,
  "author": {
    "name": "Tandemise contributors",
    "email": "tandemise@users.noreply.github.com"
  },
  "homepage": "https://github.com/tandemise/tandemise",
  "desktopName": "tandemise.desktop",
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dev:mock": "node mock/server.mjs",
    "stage-daemon": "node scripts/stage-daemon.mjs",
    "package": "electron-vite build && electron-builder --config electron-builder.config.mjs --publish never"
  },
  "devDependencies": {
    "@tandemise/api-contract": "*",
    "@tandemise/artifacts": "*",
    "@tandemise/design": "*",
    "@tandemise/domain": "*",
    "@tandemise/shared": "*",
    "@tanstack/react-query": "^5.104.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "wouter": "^3.11.1",
    "ws": "^8.22.0"
  }
}
